# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=llave-publicable-de-mentira
SUPABASE_SERVICE_ROLE_KEY=llave-de-servicio-de-mentira

# Proveedor de modelo. Ver docs/adr/0005-proveedor-llm-conmutable.md
# suscripcion = Claude Agent SDK contra la sesion local (solo desarrollo)
# api         = SDK de Anthropic con llave (mediciones formales y despliegue)
LLM_MODO=suscripcion
ANTHROPIC_API_KEY=

# Modelos
MODELO_GUARDIA=claude-haiku-4-5
MODELO_RESPUESTA=claude-sonnet-5

# Topes de gasto (ver docs/presupuesto.md)
TOPE_MENSAJES_POR_USUARIO_DIA=40
TOPE_GASTO_USD_ACUMULADO=18.00

# Protege /api/ranking/recalcular. Sin esto el endpoint queda cerrado en
# produccion y abierto solo en local.
CRON_SECRET=

# APIs gratuitas de validacion. GDELT no necesita llave.
GOOGLE_FACT_CHECK_API_KEY=
