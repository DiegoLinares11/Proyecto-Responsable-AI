# Copiar a .env.local y completar.
# Los mismos valores que NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY del portal.
# La llave publicable va en el telefono por diseño: lo que puede hacer la deciden las politicas de fila.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<llave publicable>

# Opcional. Sin esto, en desarrollo se usa la misma computadora desde la que Expo Go cargo la app, puerto 3000.
# EXPO_PUBLIC_API_URL=https://<portal desplegado>
