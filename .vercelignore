# Lo que no sube a Vercel. El servidor se arma solo con src/ y la configuración.

# Las llaves van en las variables de entorno del proyecto en Vercel, nunca
# como archivo dentro de la subida.
.env
.env.local
.env.*.local
.secret.local

# La app se compila aparte, con EAS. Y las pruebas no van a producción: algunas
# importan código de la app, que tampoco sube. De la app solo suben las
# tipografías, que el portal comparte (src/app/layout.tsx).
app-movil/*
!app-movil/assets
app-movil/assets/*
!app-movil/assets/fonts
tests

.claude
.next
supabase/.temp
tsconfig.tsbuildinfo
